# BijliBuddy Root Environment Example (see backend/.env.example and frontend/.env.example)

# Backend
DATABASE_URL=sqlite:///./bijlibuddy.db
# For Supabase PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg://postgres:<YOUR_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
AUTO_SEED_ON_EMPTY=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
