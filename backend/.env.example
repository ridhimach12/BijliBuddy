DATABASE_URL=sqlite:///./bijlibuddy.db
# Supabase PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
JWT_SECRET_KEY=replace-with-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
AUTO_SEED_ON_EMPTY=true
UPLOAD_DIR=./uploads
ML_ARTIFACTS_DIR=./artifacts_ml
